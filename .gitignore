# =============================================================================
# VID2BEDTIMESTORY CACHES & GENERATED FILES
# =============================================================================

# Root cache (embedding index - can be 1000+ frames)
cache/

# Artifacts cache (VLM captions, extracted frames)
artifacts/cache/

# Extracted frames for book pages
artifacts/frames/

# Temporary segment files
artifacts/segments/

# Generated analysis/story files (regenerate with pipeline)
# Uncomment if you don't want to track these:
# artifacts/analysis.json
# artifacts/story.md
# artifacts/pages.json
# artifacts/selected_frames.json
# artifacts/subtitles.json
# artifacts/subtitles.srt

# Output PDFs (large binary files)
out/
*.pdf

# =============================================================================
# VIDEOS (too large for git)
# =============================================================================
videos/
*.mkv
*.mp4
*.avi
*.mov
*.webm
*.m4v

# =============================================================================
# IMAGES (generated, can be regenerated)
# =============================================================================
*.png
*.jpg
*.jpeg
*.gif
*.bmp
*.tiff

# Exception: keep reference images if any
!reference/**/*.png
!reference/**/*.jpg

